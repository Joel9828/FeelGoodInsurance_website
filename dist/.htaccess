# Feel Good Insurance — Apache / LiteSpeed config (Hostinger)

Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_rewrite.c>
RewriteEngine On

# 1) Force HTTPS and the non-www host (one canonical address)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2) Old WordPress URLs -> new pages (keeps existing Google rankings)
RewriteRule ^auto-insurance/?$ /services/auto-insurance/ [R=301,L]
RewriteRule ^homeowners-insurance/?$ /services/homeowners-insurance/ [R=301,L]
RewriteRule ^commercial-insurance/?$ /services/commercial-insurance/ [R=301,L]
RewriteRule ^life-insurance/?$ /services/life-insurance/ [R=301,L]
RewriteRule ^renters-insurance/?$ /services/renters-insurance/ [R=301,L]
RewriteRule ^motorcycle-insurance/?$ /services/motorcycle-insurance/ [R=301,L]
RewriteRule ^travel-insurance/?$ /services/travel-insurance/ [R=301,L]
RewriteRule ^dmv-service/?$ /services/dmv-service/ [R=301,L]
RewriteRule ^notary-services/?$ /services/notary-services/ [R=301,L]
RewriteRule ^contact/?$ /contact-us/ [R=301,L]
RewriteRule ^about/?$ /about-us/ [R=301,L]
RewriteRule ^blog/?$ /blogs/ [R=301,L]
RewriteRule ^(.*/)?feed/?$ /blogs/ [R=301,L]
RewriteRule ^(page|tag|category|author)/.*$ /blogs/ [R=301,L]
RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^(post|page)-sitemap\.xml$ /sitemap.xml [R=301,L]
RewriteRule ^wp-(admin|login\.php|content|includes|json)(/.*)?$ / [R=301,L]

# 3) Add trailing slash to directory-style URLs (e.g. /our-gallery -> /our-gallery/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# 4) Spanish 404 page for /es/ URLs
RewriteCond %{REQUEST_URI} ^/es/
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ /es/404.html [L,R=404]
</IfModule>

ErrorDocument 404 /404.html

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Caching: fingerprinted assets for a year, HTML always fresh
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|webp|jpg|jpeg|png|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
